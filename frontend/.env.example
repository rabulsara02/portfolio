# ─────────────────────────────────────────────────────────────────────────────
# Contact form storage (Supabase)
#
# These are read ONLY on the server, inside src/app/api/contact/route.ts.
# Do NOT prefix them with NEXT_PUBLIC_ — that would inline them into the
# JavaScript bundle that ships to every visitor's browser.
#
# Set the same two variables in Vercel:
#   Project Settings -> Environment Variables
#
# If they're missing the site still builds and renders; the contact form
# just falls back to a "email me directly" link.
# ─────────────────────────────────────────────────────────────────────────────

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-key
