# ─────────────────────────────────────────────────────────────────────────────
#  Environment variables
#
#  All of these are read ONLY on the server. Do NOT prefix any of them with
#  NEXT_PUBLIC_ — that would inline them into the JavaScript bundle that ships
#  to every visitor's browser.
#
#  Set the same values in Vercel: Project Settings -> Environment Variables.
# ─────────────────────────────────────────────────────────────────────────────

# ── Contact form storage (required) ──────────────────────────────────────────
# Without these the form still renders, but shows an "email me directly"
# fallback instead of submitting.

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-anon-key


# ── Email notifications (optional) ───────────────────────────────────────────
# Emails you a copy of each submission via Resend (https://resend.com).
# Leave RESEND_API_KEY unset to turn notifications off — submissions are still
# saved to Supabase either way.
#
# CONTACT_FROM_EMAIL must be on a domain you've verified in Resend.
# CONTACT_TO_EMAIL defaults to person.email in src/content/site.ts.

RESEND_API_KEY=re_your_api_key
CONTACT_FROM_EMAIL=noreply@yourdomain.com
CONTACT_TO_EMAIL=you@gmail.com
